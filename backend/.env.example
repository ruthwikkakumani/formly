DATABASE_URL=sqlite:///./typeform.db
CORS_ORIGINS=http://localhost:3000,https://formly.rdrt.dev
FRONTEND_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Do not wrap SMTP values in quotes. Gmail app passwords must have no spaces. SMTP_FROM defaults to SMTP_USER.
# Same SMTP is used for team invites and password-reset emails. Railway often blocks 587/465; invites still get a copy link.
# RESEND_API_KEY=
# INVITE_FROM_EMAIL=Formly <onboarding@resend.dev>
# Demo logins (seeded on boot; /login loads them from GET /api/auth/demo — do not commit real passwords)
# REVIEWER_EMAIL=reviewer@formly.dev
# REVIEWER_PASSWORD=FormlyReview1
# OWNER_EMAIL=
# OWNER_PASSWORD=
# VIEWER_EMAIL=viewer@formly.dev
# VIEWER_PASSWORD=FormlyView1
